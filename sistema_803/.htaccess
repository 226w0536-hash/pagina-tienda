<IfModule mod_rewrite.c>
    # Activar rewrite
    RewriteEngine on

    # Regla para evitar que los archivos físicos reales (CSS, JS, imágenes) sean procesados por el controlador
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f

    # Redirigir todo lo demás al index.php
    # La regla ([QSA,L]) es la forma estándar de manejar los parámetros
    RewriteRule ^(.*)/(.*)$ index.php?controller=$1&action=$2 [QSA,L]
    RewriteRule ^(.*)$ index.php?controller=$1 [QSA,L]
</IfModule>
