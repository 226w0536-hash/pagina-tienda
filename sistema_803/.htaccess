<IfModule mod_rewrite.c>
    # Activar rewrite
    RewriteEngine on

    # Usamos una ruta relativa para que funcione independientemente del dominio/IP
    ErrorDocument 404 /master-php/proyecto-php-poo/error/index

    RewriteCond %{SCRIPT_FILENAME} !-d
    RewriteCond %{SCRIPT_FILENAME} !-f

    # Mantiene tu regla de enrutamiento
    RewriteRule ^(.*)/(.*) index.php?controller=$1&action=$2
</IfModule>
